diff --git a/kernel/util.h b/kernel/util.h
--- a/kernel/util.h
+++ b/kernel/util.h
@@ -4 +4,12 @@
 #include <linux/types.h>
+#include <linux/uaccess.h>
+
+static inline long ksu_strncpy_from_user_nofault_compat(char *dst,
+		const char __user *src, long count)
+{
+	long ret;
+
+	pagefault_disable();
+	ret = strncpy_from_user(dst, src, count);
+	pagefault_enable();
+	return ret;
+}
